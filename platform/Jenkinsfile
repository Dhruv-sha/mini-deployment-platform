pipeline {

    agent any    

    environment {
        DOCKER_HOST = 'unix:///var/run/docker.sock'
        DOCKER_TLS_VERIFY = ''
        DOCKER_CERT_PATH = ''
    }

    parameters {
        string(
            name: 'REPO_URL',
            defaultValue: 'https://github.com/Dhruv-sha/nodejs-application-deploy-github-actions.git',
            description: 'GitHub repository URL to deploy',
            trim: true
        )
        
        string(
            name: 'DOCKER_USERNAME',
            defaultValue: 'dhruvshah55',
            description: 'Docker Hub username',
            trim: true
        )
        string(
            name: 'APP_PORT',
            defaultValue: '3000',
            description: 'Port on which the application listens',
            trim: true
        )

        string(
            name: 'START_COMMAND',
            defaultValue: 'npm start',
            description: 'Command used to start the application inside the container',
            trim: true
        )
    }

    stages {

        stage('Checkout Platform') {
            steps {
                // Removed dir('platform') to prevent nested platform/platform directories
                checkout scm
            }
        }

        stage('Checkout Application') {
            steps {
                dir('application') {
                    git url: params.REPO_URL, branch: 'main'
                }
            }
        }

        stage('Validate Parameters') {
            steps {
                script {
                    if (!(params.APP_PORT ==~ /^[0-9]+$/)) {
                        error "APP_PORT must be a number."
                    }

                    def port = params.APP_PORT.toInteger()

                    if (port < 1 || port > 65535) {
                        error "APP_PORT must be between 1 and 65535."
                    }

                    echo "Application port: ${port}"
                }
            }
        }

        stage('Detect Application') {
            steps {
                script {
                    dir('application') {

                        sh 'chmod +x ../platform/scripts/detect-app.sh'

                        env.APP_TYPE = sh(
                            script: '../platform/scripts/detect-app.sh',
                            returnStdout: true
                        ).trim()
                    }

                    echo "Application type detected: ${env.APP_TYPE}"
                }
            }
        }

        stage('Generate Dockerfile') {
            steps {
                script {

                    def templatePath = ""

                    if (env.APP_TYPE == 'node') {
                        templatePath = "platform/templates/node/Dockerfile"

                    } else if (env.APP_TYPE == 'python') {
                        templatePath = "platform/templates/python/Dockerfile"

                    } else if (env.APP_TYPE == 'java') {
                        templatePath = "platform/templates/java/Dockerfile"

                    } else if (env.APP_TYPE == 'go') {
                        templatePath = "platform/templates/go/Dockerfile"

                    } else {
                        error "Dockerfile generation not supported for: ${env.APP_TYPE}"
                    }

                    sh """
                        cp ${templatePath} application/Dockerfile

                        sed -i "s/APP_PORT/${params.APP_PORT}/g" application/Dockerfile

                        sed -i 's|START_COMMAND|${params.START_COMMAND}|g' application/Dockerfile
                    """

                    echo "Dockerfile generated for ${env.APP_TYPE}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {

                    def imageName = "${params.DOCKER_USERNAME}/minideploy-app:${env.BUILD_NUMBER}"

                    echo "Building Docker image: ${imageName}"

                    dir('application') {
                        sh """
                            docker build -t ${imageName} .
                        """
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {

                    def imageName = "${params.DOCKER_USERNAME}/minideploy-app:${env.BUILD_NUMBER}"

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-creds',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_TOKEN'
                        )
                    ]) {

                        sh """
                            echo "\$DOCKER_TOKEN" | docker login \
                                -u "\$DOCKER_USER" \
                                --password-stdin

                            docker push ${imageName}

                            docker logout
                        """
                    }
                }
            }
        }

        stage('Generate Kubernetes Manifests') {
            steps {
                script {

                    def imageName = "${params.DOCKER_USERNAME}/minideploy-app:${env.BUILD_NUMBER}"

                    sh 'chmod +x platform/scripts/get-app-name.sh'

                    def appName = sh(
                        script: "./platform/scripts/get-app-name.sh '${params.REPO_URL}'",
                        returnStdout: true
                    ).trim()

                    echo "Application name: ${appName}"
                    echo "Docker image: ${imageName}"

                    sh """
                        mkdir -p application/k8s

                        cp platform/templates/k8s/deployment.yaml \
                        application/k8s/deployment.yaml

                        cp platform/templates/k8s/service.yaml \
                        application/k8s/service.yaml

                        sed -i "s/APP_NAME/${appName}/g" application/k8s/deployment.yaml
                        sed -i "s|DOCKER_IMAGE|${imageName}|g" application/k8s/deployment.yaml
                        sed -i "s/APP_PORT/${params.APP_PORT}/g" application/k8s/deployment.yaml

                        sed -i "s/APP_NAME/${appName}/g" application/k8s/service.yaml
                        sed -i "s/APP_PORT/${params.APP_PORT}/g" application/k8s/service.yaml
                    """
                }
            }
        }


        stage('Verify Kubernetes Manifests') {
            steps {
                sh '''
                    echo ""
                    echo "===== KUBERNETES MANIFESTS ====="

                    echo ""
                    echo "--- deployment.yaml ---"
                    cat application/k8s/deployment.yaml

                    echo ""
                    echo "--- service.yaml ---"
                    cat application/k8s/service.yaml
                '''
            }
        }

        stage('Validate Kubernetes Manifests') {
            steps {
                sh '''
                    kubectl apply --dry-run=client -f application/k8s/
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl apply -f application/k8s/
                '''
            }
        }

        stage('Wait for Deployment') {
            steps {
                script {
                    def appName = sh(
                        script: "./platform/scripts/get-app-name.sh '${params.REPO_URL}'",
                        returnStdout: true
                    ).trim()

                    sh """
                        kubectl rollout status deployment/${appName} --timeout=120s
                    """
                }
            }
        }

        stage('Verify Kubernetes Deployment') {
            steps {
                sh '''
                    echo ""
                    echo "===== DEPLOYMENTS ====="
                    kubectl get deployments

                    echo ""
                    echo "===== PODS ====="
                    kubectl get pods

                    echo ""
                    echo "===== SERVICES ====="
                    kubectl get services
                '''
            }
        }
    }
}